# NOTE: patterns below are anchored with a leading "/" so they match only at
# the repo root. Unanchored ("data/") matches a directory of that name at ANY
# depth, which silently excluded the source packages sts/data/ and sts/models/.

# ---- Data (never commit datasets; they live under data/raw) ----
/data/
/raw/
*.zip
*.tar
*.tar.gz
*.jsonl

# ---- Experiment outputs ----
/outputs/
/results/
/runs/
*.log

# ---- Model / HF caches ----
/.cache/
**/.cache/
/models/
/checkpoints/
*.pt
*.bin
*.safetensors

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.installed.cfg
*.egg

# ---- Virtual envs (env is managed by conda: "STS") ----
.venv/
venv/
env/
ENV/

# ---- Notebooks ----
.ipynb_checkpoints/

# ---- Tooling / test caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- OS / editor ----
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
*.swp

# ---- TSUBAME site config (group, paths, account: never commit) ----
tsubame/env.sh
