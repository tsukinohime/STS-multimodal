#!/bin/bash
# -----------------------------------------------------------------------------
# TSUBAME4 site configuration — copy to tsubame/env.sh and edit.
#
#   cp tsubame/env.sh.example tsubame/env.sh
#   $EDITOR tsubame/env.sh
#
# tsubame/env.sh is gitignored: nothing here (group name, paths, account) is
# hardcoded anywhere else in the repository.
#
# Verify the resource-type and storage names against the current TSUBAME
# documentation and your own account before the first submission — they are
# site-specific and do change. `qconf -sc` lists the schedulable resources.
# -----------------------------------------------------------------------------

# TSUBAME runs **Grid Engine**, so: `-g` for the group, `-l <type>=<n>` for
# resources, `-l h_rt=` for the runtime limit, `qrsh` for interactive jobs.

# ---- Accounting -------------------------------------------------------------
# Your TSUBAME group / project code, passed to qsub as -g. Leave empty to submit
# a trial run (お試し実行), which needs no group but is capped in size and
# runtime — enough for a smoke test, not for the full CxC run.
export STS_GROUP="${STS_GROUP:-}"         # e.g. tga-xxxxxx

# ---- Resources --------------------------------------------------------------
# Grid Engine requests a *resource type* by name: -l <type>=<count>.
# CONFIRM the names your system offers before the first submission — they are
# site-specific. `qconf -sc | head -40` lists the complex attributes, and the
# TSUBAME user guide tables them.
#
# This experiment is single-GPU; ask for the smallest allocation that has a GPU.
# On TSUBAME the usual names are node-fraction types such as:
#   s_gpu    1 GPU + a small CPU share   (smallest GPU allocation)
#   q_node   1 GPU + a quarter node
#   h_node   2 GPUs,  f_node  4 GPUs     (not needed: nothing here is multi-GPU)
export STS_RESOURCE="${STS_RESOURCE:-s_gpu}"
export STS_RESOURCE_COUNT="${STS_RESOURCE_COUNT:-1}"
# Runtime limit (h_rt). The full run is minutes per model on one H100, so this
# is already generous; raise it if you enable the metric bootstrap.
export STS_H_RT="${STS_H_RT:-1:00:00}"

# ---- Paths ------------------------------------------------------------------
# Repository checkout. Defaults to the repo this file lives in.
export STS_REPO="${STS_REPO:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

# Datasets. Point at group storage (/gs/bs/<group>/... or /gs/fs/<group>/...)
# rather than $HOME, whose quota is small.
export STS_DATA_ROOT="${STS_DATA_ROOT:-$STS_REPO/data/raw}"

# Experiment outputs and the embedding cache. Both grow; keep them off $HOME.
export STS_OUTPUT_DIR="${STS_OUTPUT_DIR:-$STS_REPO/outputs/text_only}"
export STS_CACHE_DIR="${STS_CACHE_DIR:-$STS_REPO/.cache/embeddings}"

# Job stdout/stderr.
export STS_LOG_DIR="${STS_LOG_DIR:-$STS_REPO/logs}"

# ---- Hugging Face -----------------------------------------------------------
# Model weights live here. Compute nodes generally cannot reach the internet, so
# this must be on a shared filesystem the login node has already populated
# (see tsubame/prefetch_models.sh).
export HF_HOME="${HF_HOME:-$STS_REPO/.cache/huggingface}"
export HF_HUB_CACHE="${HF_HUB_CACHE:-$HF_HOME/hub}"

# Set to 1 in the job so a cache miss fails loudly instead of hanging on a
# network call. prefetch_models.sh unsets it.
export HF_HUB_OFFLINE="${HF_HUB_OFFLINE:-1}"

# If your group has an HTTP proxy for the login node, set it here; the prefetch
# script picks it up. Leave empty when logging in gives you direct access.
export STS_HTTP_PROXY="${STS_HTTP_PROXY:-}"   # e.g. http://proxy.example.ac.jp:3128

# ---- Python environment -----------------------------------------------------
# Python must be >= 3.10 (3.11 recommended). The system 3.9 cannot install
# transformers 5.x, which the main model requires — see tsubame/README.md.
#
# Choose exactly one activation style.
#
#   conda : STS_CONDA_ENV is the env name *or* an absolute path (prefer a path
#           on group storage, created with `conda create -p ...`, so the env
#           does not consume the home quota); STS_CONDA_SH points at the conda
#           profile script (`conda info --base` -> etc/profile.d/conda.sh).
#   venv  : STS_VENV points at the virtualenv directory.
#
export STS_ENV_KIND="${STS_ENV_KIND:-conda}"      # conda | venv | none
export STS_CONDA_ENV="${STS_CONDA_ENV:-STS}"
export STS_CONDA_SH="${STS_CONDA_SH:-}"           # e.g. $HOME/miniconda3/etc/profile.d/conda.sh
export STS_VENV="${STS_VENV:-}"                   # e.g. $STS_REPO/.venv

# Modules to load before activating the environment. Run `module avail` on a
# login node to see what your system offers, then pin the versions.
export STS_MODULES="${STS_MODULES:-}"             # e.g. "cuda/12.3.2 cudnn/9.0.0"

# ---- Experiment -------------------------------------------------------------
export STS_CONFIG="${STS_CONFIG:-configs/text_only.yaml}"
# Model keys from the YAML. submit.sh sends one independent job per key.
export STS_MODELS="${STS_MODELS:-jina-v5-omni-small jina-v5-text-small}"
export STS_BATCH_SIZE="${STS_BATCH_SIZE:-64}"
export STS_DTYPE="${STS_DTYPE:-bfloat16}"
